    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 强调色：桃粉 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6B9D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF85B0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#F25287"/>
    <SolidColorBrush x:Key="AccentAlphaBrush" Color="#2EFF6B9D"/>
