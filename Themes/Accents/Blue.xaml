<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 强调色：科技蓝（WinUI 3 官方强调色系；ThemeService 按深浅主题派生对比度安全变体） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1B86DE"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="AccentAlphaBrush" Color="#1F0078D4"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#2E0078D4"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#1F0078D4"/>

</ResourceDictionary>
