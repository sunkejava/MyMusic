<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 强调色：暖橙 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFA94D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFBC70"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#F29235"/>
    <SolidColorBrush x:Key="AccentAlphaBrush" Color="#2EFA9235"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#52FA9235"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#2EFA9235"/>

</ResourceDictionary>
