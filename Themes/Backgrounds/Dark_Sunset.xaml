<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色背景：落日橙 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#2B1D18" Offset="0"/>
        <GradientStop Color="#1E1412" Offset="0.55"/>
        <GradientStop Color="#140E0D" Offset="1"/>
    </LinearGradientBrush>

    <!-- 侧边栏：与背景同色系的半透明深色面板 -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E61E1310" Offset="0"/>
        <GradientStop Color="#F2110A09" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
