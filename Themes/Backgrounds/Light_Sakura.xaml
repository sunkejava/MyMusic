<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色背景：樱花粉 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#FAF1F3" Offset="0"/>
        <GradientStop Color="#F6E9ED" Offset="0.55"/>
        <GradientStop Color="#F2E1E7" Offset="1"/>
    </LinearGradientBrush>

    <!-- 侧边栏：与背景同色系的半透明面板，略深于主背景形成层次 -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F4E6EA" Offset="0"/>
        <GradientStop Color="#F2EDD9E0" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
