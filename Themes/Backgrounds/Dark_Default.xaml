<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色背景：静谧灰（Fluent 石板蓝灰，呼应 #1E1E1E~#0F172A 暗黑科技感） -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#23252E" Offset="0"/>
        <GradientStop Color="#181A22" Offset="0.55"/>
        <GradientStop Color="#101218" Offset="1"/>
    </LinearGradientBrush>

    <!-- 侧边栏：与背景同色系的半透明深色面板 -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F01A1C24" Offset="0"/>
        <GradientStop Color="#F5101218" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
