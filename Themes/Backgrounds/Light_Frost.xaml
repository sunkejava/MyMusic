<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色背景：霜天蓝 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#F1F5FA" Offset="0"/>
        <GradientStop Color="#EAF0F8" Offset="0.55"/>
        <GradientStop Color="#E3EBF5" Offset="1"/>
    </LinearGradientBrush>

    <!-- 侧边栏：与背景同色系的半透明面板，略深于主背景形成层次 -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2E8EFF8" Offset="0"/>
        <GradientStop Color="#F2DCE6F3" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
