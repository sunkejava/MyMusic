<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色背景：暖沙米 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#F9F5EC" Offset="0"/>
        <GradientStop Color="#F5EFE2" Offset="0.55"/>
        <GradientStop Color="#F0E8D8" Offset="1"/>
    </LinearGradientBrush>

    <!-- 侧边栏：与背景同色系的半透明面板，略深于主背景形成层次 -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F2EBDD" Offset="0"/>
        <GradientStop Color="#F2E9DFC9" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
