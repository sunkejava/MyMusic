<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- 浅色主题调色板 -->
    <s:Boolean x:Key="ThemeIsDark">False</s:Boolean>

    <!-- 结构层 -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="PlayerBarBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="TopBarBrush" Color="#01FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1F000000"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F2329"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5F6672"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#9AA0AB"/>

    <!-- 图标 -->
    <SolidColorBrush x:Key="IconBrush" Color="#5F6672"/>
    <SolidColorBrush x:Key="IconHoverBrush" Color="#1F2329"/>

    <!-- 其他 -->
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#E3E6EB"/>
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="#59000000"/>
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="LyricInactiveBrush" Color="#9AA0AB"/>
    <!-- 歌词高亮色：默认跟随强调色，可由设置页自定义覆盖 -->
    <DynamicResource x:Key="LyricActiveBrush" ResourceKey="AccentBrush"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D54941"/>
    <SolidColorBrush x:Key="TooltipBrush" Color="#FFFFFF"/>
    <!-- 弹窗磨砂背景：配合 DWM 毛玻璃（GlassFrameThickness=-1），保留一定透明度透出桌面 -->
    <SolidColorBrush x:Key="DialogFrostBrush" Color="#D9FFFFFF"/>
    <!-- 播放队列面板：窗内微透明面板背景，透出页面内容形成轻磨砂层次 -->
    <SolidColorBrush x:Key="QueuePanelBrush" Color="#EBFFFFFF"/>
    <!-- 播放页沉浸模式：封面取色背景上的主题遮罩，保证文字可读 -->
    <SolidColorBrush x:Key="PlayScrimBrush" Color="#E6F7F8FA"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>

</ResourceDictionary>
