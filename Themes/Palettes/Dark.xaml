<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- 深色主题调色板 -->
    <s:Boolean x:Key="ThemeIsDark">True</s:Boolean>

    <!-- 结构层（半透明叠加在背景之上） -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="PlayerBarBrush" Color="#E6121217"/>
    <SolidColorBrush x:Key="TopBarBrush" Color="#01000000"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1FFFFFFF"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8BCC4"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#7A7F89"/>

    <!-- 图标 -->
    <SolidColorBrush x:Key="IconBrush" Color="#B8BCC4"/>
    <SolidColorBrush x:Key="IconHoverBrush" Color="#F5F6F8"/>

    <!-- 其他 -->
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#2A2E36"/>
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="LyricInactiveBrush" Color="#6E7480"/>
    <!-- 歌词高亮色：默认跟随强调色，可由设置页自定义覆盖 -->
    <DynamicResource x:Key="LyricActiveBrush" ResourceKey="AccentBrush"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5534B"/>
    <SolidColorBrush x:Key="TooltipBrush" Color="#2A2E36"/>
    <!-- 弹窗磨砂背景：配合 DWM 毛玻璃（GlassFrameThickness=-1），保留一定透明度透出桌面 -->
    <SolidColorBrush x:Key="DialogFrostBrush" Color="#D92A2E36"/>
    <!-- 播放队列面板：窗内微透明面板背景，透出页面内容形成轻磨砂层次 -->
    <SolidColorBrush x:Key="QueuePanelBrush" Color="#EB2A2E36"/>
    <!-- 播放页沉浸模式：封面取色背景上的主题遮罩，保证文字可读 -->
    <SolidColorBrush x:Key="PlayScrimBrush" Color="#8C0B0C0E"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000"/>

</ResourceDictionary>
