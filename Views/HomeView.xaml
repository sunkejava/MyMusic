<UserControl x:Class="MyQQMusic.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="700">

    <UserControl.Resources>
        <!-- 推荐卡片按钮（透明容器） -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 推荐歌曲卡片 -->
        <DataTemplate x:Key="SongCardTemplate">
            <Button x:Name="CardBtn" Style="{StaticResource CardButtonStyle}" Width="150" Margin="0,0,18,18"
                    Command="{Binding DataContext.PlayRecommendCommand,
                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" ToolTip="{Binding DisplayTitle}">
                <StackPanel>
                    <Border CornerRadius="10" Height="150">
                        <Grid>
                            <Border CornerRadius="10" Background="{DynamicResource CoverPlaceholderBrush}">
                                <Path Data="{DynamicResource IconMusic}" Width="34" Height="34"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{DynamicResource TertiaryTextBrush}"/>
                            </Border>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CoverThumb}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="PlayMask" CornerRadius="10" Background="#33000000" Opacity="0">
                                <Path Data="{DynamicResource IconPlayCircle}" Width="40"
                                      Height="40" Stretch="Uniform" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" Margin="2,8,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Artist}" FontSize="11" Margin="2,3,0,0"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBtn}" Value="True">
                    <Setter TargetName="PlayMask" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- 空状态 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSongs}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Path Data="{DynamicResource IconDisc}" Width="72" Height="72" Stretch="Uniform"
                  Fill="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="还没有本地音乐" Style="{StaticResource SectionTitleStyle}"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,8,0,0"
                       Text="请在「设置」中选择你的音乐文件夹，然后点击「重新扫描」导入本地音乐。"/>
        </StackPanel>

        <!-- 正常内容 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
            <StackPanel>
                <!-- 欢迎 + 快捷操作 -->
                <DockPanel LastChildFill="False" Margin="0,0,0,20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="为你推荐"/>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"
                                   Text="根据你的本地曲库随机生成，随时发现喜欢的歌"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PlayMainButtonStyle}" Width="Auto" Height="36"
                                Command="{Binding PlayHotAllCommand}" ToolTip="播放热门歌曲">
                            <StackPanel Orientation="Horizontal" Margin="14,0">
                                <Path Data="{DynamicResource IconPlay}" Width="13" Height="13"
                                      Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}"/>
                                <TextBlock Text="播放热门" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentTextButtonStyle}" Height="36" Padding="16,0"
                                Margin="10,0,0,0" Command="{Binding ShuffleAllCommand}" ToolTip="随机播放全部">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconShuffle}" Width="13" Height="13"
                                      Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="随机播放" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- 推荐卡片 -->
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="猜你想听" Margin="0,0,0,14"/>
                <ItemsControl ItemsSource="{Binding Recommendations}"
                              ItemTemplate="{StaticResource SongCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 热门歌曲 -->
                <DockPanel LastChildFill="False" Margin="0,10,0,10">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="热门歌曲"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentTextButtonStyle}"
                            Height="30" Padding="12,0" Command="{Binding PlayHotAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconPlay}" Width="11" Height="11"
                                  Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="播放全部" Margin="6,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding HotSongs}"
                              ItemTemplate="{StaticResource SongRowTemplate}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
