<Window x:Class="MyQQMusic.Views.DedupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="歌单去重" Width="660" Height="560"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- 磨砂弹窗：与收藏歌单弹窗同风格 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="12"
                            GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource DialogFrostBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <DockPanel Margin="18,14,18,14">

            <!-- 标题（可拖动） -->
            <Grid DockPanel.Dock="Top" Margin="2,0,0,10" Background="Transparent"
                  MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="歌单去重" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                </StackPanel>
                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                        HorizontalAlignment="Right" ToolTip="关闭" Click="Close_Click">
                    <Path Data="{DynamicResource IconClose}" Width="12" Height="12"
                          Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                </Button>
            </Grid>

            <!-- 底部：删除选项 + 操作 -->
            <Grid DockPanel.Dock="Bottom" Margin="2,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="DelFilesBox" Content="同时删除本地文件"
                          Style="{StaticResource ThemeCheckBoxStyle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0,12,0" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TertiaryTextBrush}"/>
                <Button x:Name="DeleteBtn" Grid.Column="2" Content="删除重复项" Height="34" Padding="20,0"
                        IsEnabled="False" Style="{StaticResource AccentTextButtonStyle}"
                        Click="Delete_Click"/>
            </Grid>

            <!-- 重复组列表（code-behind 动态构建） -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel x:Name="GroupsPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
