<Window x:Class="MyQQMusic.Views.SyncMetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="同步在线元信息" Width="760" Height="620"
        WindowStyle="None" Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- 与主窗口一致的窗口边框（圆角 + 主题背景） -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="12"
                            GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <DockPanel>

            <!-- 标题栏（与主窗口顶栏同风格，可拖动） -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource TopBarBrush}"
                    CornerRadius="12,12,0,0" Height="46" Padding="18,0,14,0"
                    MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{DynamicResource IconImage}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="同步在线元信息" FontSize="15" FontWeight="Bold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                            HorizontalAlignment="Right" ToolTip="关闭" Click="Close_Click">
                        <Path Data="{DynamicResource IconClose}" Width="12" Height="12"
                              Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <DockPanel Margin="18,12,18,14">

            <!-- 目标歌曲 -->
            <Border DockPanel.Dock="Top" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                    Background="{DynamicResource InputBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="目标歌曲" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                    <TextBlock x:Name="SongTitle" FontSize="12" Margin="12,0,0,0" MaxWidth="300"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SongArtist" FontSize="11" Margin="10,0,0,0" MaxWidth="260"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 音源选择 + 搜索 -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="SourcePanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SrcQQ" Content="QQ音乐" Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,6,0" Click="Source_Click"/>
                    <Button x:Name="SrcNetease" Content="网易云音乐" Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,6,0" Click="Source_Click"/>
                    <Button x:Name="SrcKugou" Content="酷狗音乐" Style="{StaticResource ChipButtonStyle}"
                            Click="Source_Click"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="32" Margin="14,0,0,0"
                         Style="{StaticResource SearchBoxStyle}"
                         KeyDown="SearchBox_KeyDown"/>
            </Grid>

            <!-- 底部：状态 + 同步按钮 -->
            <Grid DockPanel.Dock="Bottom" Margin="2,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TertiaryTextBrush}"/>
                <Button x:Name="ApplyBtn" Grid.Column="1" Content="同步到本地" Height="34" Padding="20,0"
                        IsEnabled="False" Style="{StaticResource AccentTextButtonStyle}"
                        Click="Apply_Click"/>
            </Grid>

            <!-- 中部：搜索结果 + 元信息预览 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="252"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ResultList" Style="{StaticResource PlainListBoxStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="ResultList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Margin="0,3,0,0" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Artist, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Album, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" Text="{Binding DurationText}"
                                           Foreground="{DynamicResource TertiaryTextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="10" Padding="14"
                        Background="{DynamicResource InputBrush}">
                    <StackPanel>
                        <Border Width="150" Height="150" CornerRadius="8" HorizontalAlignment="Center"
                                Background="{DynamicResource CoverPlaceholderBrush}">
                            <Image x:Name="CoverImg" Width="150" Height="150" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="PTitle" Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="40"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="PArtist" Margin="0,4,0,0" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="PAlbum" Margin="0,2,0,0" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="PGenre" Margin="0,2,0,0" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Border Height="1" Margin="0,10,0,8" Background="{DynamicResource LineBrush}"/>
                        <TextBlock Text="歌词预览" FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}"/>
                        <TextBlock x:Name="PLyric" Margin="0,4,0,0" FontSize="11" MaxHeight="150"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
