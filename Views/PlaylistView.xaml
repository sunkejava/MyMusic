<UserControl x:Class="MyQQMusic.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="700">

    <UserControl.Resources>
        <!-- 歌单行删除按钮：悬停行时显示 -->
        <Style x:Key="RowDeleteStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowHost}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 歌单内歌曲行：共享模板 + 悬停删除 -->
        <DataTemplate x:Key="PlaylistSongRow">
            <Grid x:Name="RowHost">
                <!-- 右侧预留 40px 给删除按钮，避免与时长/更多列重叠 -->
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SongRowTemplate}"
                                  Margin="0,0,40,0"/>
                <Button Style="{StaticResource RowDeleteStyle}" HorizontalAlignment="Right"
                        Margin="0,0,6,0" ToolTip="从歌单移除"
                        Command="{Binding DataContext.RemoveSongCommand,
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Path Data="{DynamicResource IconTrash}" Width="14" Height="14"
                          Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧：歌单列表 ================= -->
        <DockPanel Grid.Column="0" Margin="20,22,8,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitleStyle}" Text="歌单"
                       Margin="4,0,0,14"/>

            <!-- 新建歌单 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource InputBrush}" CornerRadius="8"
                    Padding="10,0" Margin="0,0,0,12" Height="36">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}"
                            Width="28" Height="28" ToolTip="创建歌单"
                            Command="{Binding CreatePlaylistCommand}">
                        <Path Data="{DynamicResource IconPlus}" Width="14" Height="14"
                              Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                    </Button>
                    <TextBox Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                             FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreatePlaylistCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Border>

            <!-- 歌单 -->
            <ListBox Style="{StaticResource PlainListBoxStyle}" ItemsSource="{Binding Playlists}"
                     SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="PlIcon" Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                  Margin="12,0,0,0" Data="{DynamicResource IconPlaylist}"
                                  Fill="{DynamicResource IconBrush}"/>
                            <TextBlock x:Name="PlName" Grid.Column="1" Text="{Binding Name}" Margin="12,0,4,0"
                                       VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0} 首}"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                            <Button x:Name="DelBtn" Grid.Column="3" Width="28" Height="28" Opacity="0"
                                    Margin="2,0,6,0" ToolTip="删除歌单" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding DataContext.DeletePlaylistCommand,
                                             RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Path Data="{DynamicResource IconTrash}" Width="13" Height="13"
                                      Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                            </Button>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                <Setter TargetName="PlIcon" Property="Data" Value="{DynamicResource IconHeartFilled}"/>
                                <Setter TargetName="DelBtn" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter TargetName="DelBtn" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter TargetName="PlName" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="PlName" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="PlIcon" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,22,0,0"
                Background="{DynamicResource LineBrush}"/>

        <!-- ================= 右侧：歌单内容 ================= -->
        <Grid Grid.Column="1" Margin="28,22,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 歌单头部：名称与按钮分行显示，两者都完整展示（长名称自动换行） -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding SelectedPlaylist.Name}"
                               TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"
                               Text="{Binding SelectedPlaylist.Count, StringFormat=共 {0} 首歌曲}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource PlayMainButtonStyle}" Width="Auto" Height="36"
                            Command="{Binding PlayAllCommand}" ToolTip="播放整个歌单">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path Data="{DynamicResource IconPlay}" Width="13" Height="13"
                                  Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}"/>
                            <TextBlock Text="播放全部" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnAccentBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentTextButtonStyle}" Height="36" Padding="14,0"
                            Margin="10,0,0,0" Command="{Binding PlayLoopCommand}"
                            ToolTip="列表循环播放此歌单">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconRepeat}" Width="13" Height="13"
                                  Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="循环播放" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentTextButtonStyle}" Height="36" Padding="14,0"
                            Margin="10,0,0,0" Command="{Binding PlayShuffleCommand}"
                            ToolTip="随机播放此歌单">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconShuffle}" Width="13" Height="13"
                                  Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="随机播放" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentTextButtonStyle}" Height="36" Padding="14,0"
                            Margin="10,0,0,0" ToolTip="自动识别歌单中的重复歌曲，可选择是否同时删除本地文件"
                            Click="Dedup_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconCheck}" Width="13" Height="13"
                                  Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="去重" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentTextButtonStyle}" Height="36" Padding="14,0"
                            Margin="10,0,0,0" ToolTip="按自定义规则与音源，批量同步歌单全部歌曲的在线元信息"
                            Click="BatchSync_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconSparkle}" Width="13" Height="13"
                                  Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="批量同步" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentTextButtonStyle}" Height="36" Padding="16,0"
                            Margin="10,0,0,0" Command="{Binding DeletePlaylistCommand}"
                            CommandParameter="{Binding SelectedPlaylist}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IconTrash}" Width="12" Height="12"
                                  Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="删除歌单" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 歌单歌曲（分页，每页 100 条）：ListBox 提供选中行高亮 -->
            <ListBox Grid.Row="1" Style="{StaticResource PlainListBoxStyle}"
                     ItemsSource="{Binding PagedSongs}"
                     ItemTemplate="{StaticResource PlaylistSongRow}"/>

            <!-- 分页条 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,10,0,14" Visibility="{Binding HasPagination, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                        ToolTip="上一页" Command="{Binding PrevPageCommand}"
                        IsEnabled="{Binding HasPreviousPage}">
                    <Path Data="{DynamicResource IconPrev}" Width="11" Height="11" Stretch="Uniform"
                          Fill="{DynamicResource IconBrush}"/>
                </Button>
                <TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center" Margin="12,0"
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                        ToolTip="下一页" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding HasNextPage}">
                    <Path Data="{DynamicResource IconNext}" Width="11" Height="11" Stretch="Uniform"
                          Fill="{DynamicResource IconBrush}"/>
                </Button>
            </StackPanel>

            <!-- 未选中歌单 -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="{DynamicResource IconPlaylist}" Width="52" Height="52" Stretch="Uniform"
                      Fill="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="选择或创建一个歌单" Style="{StaticResource SectionTitleStyle}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,6,0,0"
                           Text="在左侧输入名称即可创建新歌单；在任意歌曲行的右键菜单可以把它加入歌单。"/>
            </StackPanel>

            <!-- 歌单为空 -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSelection}" Value="True"/>
                                    <Condition Binding="{Binding HasSongs}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="{DynamicResource IconMusic}" Width="52" Height="52" Stretch="Uniform"
                      Fill="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="歌单还是空的" Style="{StaticResource SectionTitleStyle}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,6,0,0"
                           Text="去「音乐库」找到喜欢的歌，右键选择「加入歌单」即可收藏到这里。"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
