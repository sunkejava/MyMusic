<Window x:Class="MyQQMusic.Views.DeskLyricWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面歌词" Width="560" Height="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        FontFamily="{DynamicResource AppFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- 桌面歌词：默认全透明可拖动；悬停显示磨砂背景与缩放手柄，右下角可调整大小，双击回主窗播放页 -->
    <Border x:Name="Root" CornerRadius="10" Background="#00000000" Padding="24,10"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Grid>
            <!-- 磨砂背景层：鼠标移入淡入，用于看清控件范围与调整大小 -->
            <Border x:Name="FrostBg" CornerRadius="10" Opacity="0" IsHitTestVisible="False"
                    Background="#66232529" BorderBrush="#4DA8ADB3" BorderThickness="1"/>
            <!-- 歌词：当前行（卡拉OK模式下由代码裁剪 LineNowAccent 实现逐字变色） + 下一行 -->
            <StackPanel x:Name="LyricView" VerticalAlignment="Center">
                <Grid HorizontalAlignment="Stretch">
                    <TextBlock x:Name="LineNow" Text="" HorizontalAlignment="Center"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LineNowAccent" Text="" HorizontalAlignment="Center"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock x:Name="LineNext" Text="" HorizontalAlignment="Center" Margin="0,6,0,0"
                           Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 暂停 / 无歌词：歌名 — 歌手 -->
            <StackPanel x:Name="TitleView" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="" HorizontalAlignment="Center"
                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Text="" HorizontalAlignment="Center" Margin="0,6,0,0"
                           Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button x:Name="CloseBtn" Width="24" Height="24" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Visibility="Hidden" ToolTip="关闭桌面歌词"
                    Style="{StaticResource IconButtonStyle}" Click="CloseBtn_Click">
                <Path x:Name="CloseIcon" Data="{DynamicResource IconClose}" Width="10" Height="10"
                      Stretch="Uniform" Fill="White"/>
            </Button>

            <!-- 右下角缩放手柄：按住拖动调整控件大小（悬停时显示） -->
            <Border x:Name="ResizeGrip" Width="24" Height="24" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Transparent" Opacity="0"
                    ToolTip="拖动调整桌面歌词大小"
                    MouseLeftButtonDown="ResizeGrip_Down" MouseMove="ResizeGrip_Move"
                    MouseLeftButtonUp="ResizeGrip_Up">
                <Path Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M13,3 L13,13 L3,13 M13,7.5 L7.5,13" Stroke="#B3FFFFFF" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
        </Grid>
    </Border>
</Window>
