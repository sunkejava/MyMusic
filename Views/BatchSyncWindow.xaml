<Window x:Class="MyQQMusic.Views.BatchSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="批量同步在线元信息" Width="620" Height="520"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- 磨砂弹窗：与收藏歌单弹窗同风格 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="12"
                            GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource DialogFrostBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <DockPanel Margin="18,14,18,14">

            <!-- 标题（可拖动） -->
            <Grid DockPanel.Dock="Top" Margin="2,0,0,10" Background="Transparent"
                  MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="批量同步在线元信息" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                </StackPanel>
                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                        HorizontalAlignment="Right" ToolTip="关闭" Click="Close_Click">
                    <Path Data="{DynamicResource IconClose}" Width="12" Height="12"
                          Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                </Button>
            </Grid>

            <!-- 底部：开始 / 取消 -->
            <Grid DockPanel.Dock="Bottom" Margin="2,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TertiaryTextBrush}"/>
                <Button x:Name="CancelBtn" Grid.Column="1" Content="取消" Height="34" Padding="18,0"
                        Margin="10,0,0,0" IsEnabled="False" Style="{StaticResource AccentTextButtonStyle}"
                        Click="Cancel_Click"/>
                <Button x:Name="StartBtn" Grid.Column="2" Content="开始同步" Height="34" Padding="20,0"
                        Margin="10,0,0,0" Style="{StaticResource AccentTextButtonStyle}"
                        Click="Start_Click"/>
            </Grid>

            <StackPanel>
                <!-- 同步源 -->
                <TextBlock Text="同步源" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource InputBrush}">
                    <StackPanel x:Name="SourcePanel" Orientation="Horizontal">
                        <Button x:Name="SrcQQ" Content="QQ音乐" Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,6,0" Click="Source_Click"/>
                        <Button x:Name="SrcNetease" Content="网易云音乐" Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,6,0" Click="Source_Click"/>
                        <Button x:Name="SrcKugou" Content="酷狗音乐" Style="{StaticResource ChipButtonStyle}"
                                Click="Source_Click"/>
                    </StackPanel>
                </Border>

                <!-- 写回内容 -->
                <TextBlock Text="写回内容" FontSize="12" FontWeight="SemiBold" Margin="2,14,0,6"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource InputBrush}">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="OptText" Content="歌名 / 歌手 / 专辑 / 风格" IsChecked="True"
                                      Style="{StaticResource ThemeCheckBoxStyle}" Margin="0,2,26,2"/>
                            <CheckBox x:Name="OptCover" Content="封面海报" IsChecked="True"
                                      Style="{StaticResource ThemeCheckBoxStyle}" Margin="0,2,26,2"/>
                            <CheckBox x:Name="OptLyric" Content="歌词（保存为 .lrc）" IsChecked="True"
                                      Style="{StaticResource ThemeCheckBoxStyle}" Margin="0,2,0,2"/>
                        </WrapPanel>
                        <TextBlock Text="酷狗音源不提供歌词；风格类型仅酷狗可能提供。" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TertiaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 匹配与跳过规则 -->
                <TextBlock Text="匹配与跳过规则" FontSize="12" FontWeight="SemiBold" Margin="2,14,0,6"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource InputBrush}">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="OptStrict" Content="严格时长匹配（±5 秒才写回）"
                                      Style="{StaticResource ThemeCheckBoxStyle}" Margin="0,2,26,2"/>
                            <CheckBox x:Name="OptSkipCover" Content="跳过已有封面的歌曲"
                                      Style="{StaticResource ThemeCheckBoxStyle}" Margin="0,2,26,2"/>
                            <CheckBox x:Name="OptSkipLyric" Content="跳过已有歌词的歌曲"
                                      Style="{StaticResource ThemeCheckBoxStyle}" Margin="0,2,0,2"/>
                        </WrapPanel>
                        <TextBlock Text="默认使用网易云音乐源，按歌名+歌手搜索；在时长匹配的候选中优先采用带歌词的元信息。"
                                   FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TertiaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 进度 -->
                <TextBlock x:Name="CurrentText" Text="尚未开始" FontSize="12" Margin="2,16,0,6"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ProgressBar x:Name="Progress" Height="4" Value="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border CornerRadius="2" Background="{DynamicResource LineBrush}"/>
                                <!-- ProgressBar 依据 PART_Track 宽度计算 PART_Indicator 宽度，二者缺一不可 -->
                                <Border x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentBrush}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="StatusText" FontSize="11" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TertiaryTextBrush}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
