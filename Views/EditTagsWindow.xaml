<Window x:Class="MyQQMusic.Views.EditTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="编辑标签" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <Border CornerRadius="14" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="22,16,22,20">

            <!-- 标题栏 -->
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}"
                        Width="32" Height="32" Click="Close_Click" ToolTip="关闭">
                    <Path Data="{DynamicResource IconClose}" Width="14" Height="14"
                          Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                </Button>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="编辑标签"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 歌曲文件信息 -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Border x:Name="CoverBox" Width="48" Height="48" CornerRadius="6" VerticalAlignment="Center"
                        Background="{DynamicResource CoverPlaceholderBrush}">
                    <Image x:Name="CoverImg" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    <TextBlock x:Name="PathText" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                </StackPanel>
            </StackPanel>

            <!-- 标签表单 -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="标题" FontSize="12" Margin="0,9,0,9"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Height="32"
                         Padding="10,0" FontSize="13" VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}"
                         BorderThickness="1" Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="歌手" FontSize="12" Margin="0,9,0,9"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox x:Name="ArtistBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Height="32"
                         Padding="10,0" FontSize="13" VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}"
                         BorderThickness="1" Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="专辑" FontSize="12" Margin="0,9,0,9"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox x:Name="AlbumBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Height="32"
                         Padding="10,0" FontSize="13" VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}"
                         BorderThickness="1" Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="曲目号" FontSize="12" Margin="0,9,0,9"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox x:Name="TrackBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Height="32" Width="90"
                         HorizontalAlignment="Left" Padding="10,0" FontSize="13"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}"
                         BorderThickness="1" Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"/>
            </Grid>

            <!-- 错误提示 -->
            <TextBlock x:Name="ErrorText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed" Foreground="{DynamicResource DangerBrush}"/>

            <!-- 操作按钮 -->
            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <Button x:Name="ReloadBtn" DockPanel.Dock="Left" Style="{StaticResource AccentTextButtonStyle}"
                        Height="34" Padding="14,0" Click="Reload_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconRefresh}" Width="13" Height="13"
                              Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="从文件重新读取" Margin="6,0,0,0" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelBtn" DockPanel.Dock="Right" Style="{StaticResource ChipButtonStyle}"
                        Height="34" Padding="18,0" Content="取消" Click="Close_Click"/>
                <Button x:Name="SaveBtn" DockPanel.Dock="Right" Style="{StaticResource PlayMainButtonStyle}"
                        Height="34" Margin="0,0,10,0" Padding="20,0" Click="Save_Click">
                    <TextBlock x:Name="SaveText" Text="保存" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnAccentBrush}"/>
                </Button>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
