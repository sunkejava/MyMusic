<UserControl x:Class="MyQQMusic.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" Margin="0,0,0,20"/>

            <!-- ================= 主题 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="主题模式"/>
            <ItemsControl ItemsSource="{Binding ThemeItems}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0" Padding="18,8"
                                Content="{Binding Name}"
                                Command="{Binding DataContext.SetThemeCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.Theme"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= 强调色 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="强调色" Margin="0,26,0,0"/>
            <ItemsControl ItemsSource="{Binding AccentItems}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="44" Height="44" Margin="0,0,10,0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" ToolTip="{Binding Name}"
                                FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.SetAccentCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.Accent"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Ring" Width="40" Height="40" Fill="Transparent"
                                                 Stroke="{DynamicResource LineBrush}" StrokeThickness="2"/>
                                        <Ellipse Width="30" Height="30" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" Fill="{Binding Extra}"/>
                                        <Path x:Name="Check" Data="{DynamicResource IconCheck}" Width="14"
                                              Height="14" Stretch="Uniform" Fill="White" Opacity="0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= 背景 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="窗口背景" Margin="0,26,0,0"/>
            <ItemsControl ItemsSource="{Binding AvailableBackgrounds}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0" Padding="18,8"
                                Content="{Binding Name}" Click="BackgroundChip_Click">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.Background"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 背景微调：仅在选择自定义图片时显示 -->
            <StackPanel Margin="0,14,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Background}" Value="Custom">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="16,14">
                    <Grid MaxWidth="520" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BodyTextStyle}"
                                   Text="背景透明度"/>
                        <Slider Grid.Row="0" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding BackgroundOpacity}"
                                Style="{StaticResource QQSliderStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right"
                                   FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"
                                   Text="{Binding BackgroundOpacity, StringFormat={}{0}%}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BodyTextStyle}"
                                   Text="磨砂效果"/>
                        <Slider Grid.Row="2" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding BackgroundBlur}"
                                Style="{StaticResource QQSliderStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right"
                                   FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"
                                   Text="{Binding BackgroundBlur, StringFormat={}{0}px}"/>
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="2,10,0,0"
                           Text="降低透明度并开启磨砂，可避免背景图片过花导致控件文字看不清。"/>
            </StackPanel>

            <!-- ================= 播放模式 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="播放模式" Margin="0,26,0,0"/>
            <ItemsControl ItemsSource="{Binding PlayThemeItems}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0" Padding="18,8"
                                Content="{Binding Name}"
                                Command="{Binding DataContext.SetPlayThemeCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.PlayTheme"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,10,0,0"
                       Text="标准模式（方形大封面）、黑胶模式（旋转黑胶与唱臂）、歌词模式（整页居中歌词与封面氛围背景）。"/>

            <!-- ================= 播放皮肤 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="播放皮肤" Margin="0,26,0,0"/>
            <ItemsControl ItemsSource="{Binding SkinGroups}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Group}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 共用色卡样式：当前皮肤带勾选徽章与名称强调色 -->
                                        <Button Margin="0,0,8,8"
                                                Style="{StaticResource SkinSwatchStyle}"
                                                Command="{Binding DataContext.SetSkinCommand,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource EqualConv}">
                                                    <Binding Path="DataContext.PlayerSkin"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="Key"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="皮肤会改变整个播放页的背景、文字与歌词颜色、唱片配色及音波/星空氛围；选择「跟随主题」恢复主题外观。"/>
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox Content="播放时跟随歌曲海报主色生成氛围背景"
                              Style="{StaticResource ThemeCheckBoxStyle}" FontSize="13"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              IsChecked="{Binding CoverAmbient}"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="26,8,0,0" TextWrapping="Wrap"
                               Text="自动提取当前歌曲海报的关键色，生成柔和渐变作为播放页背景；仅在播放皮肤为「跟随主题」时生效。"/>
                </StackPanel>
            </Border>

            <!-- ================= 歌词高亮 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="歌词高亮" Margin="0,26,0,0"/>
            <ItemsControl ItemsSource="{Binding LyricHighlightItems}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0" Padding="18,8"
                                Content="{Binding Name}"
                                Command="{Binding DataContext.SetLyricHighlightCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.LyricHighlight"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="正在播放页与桌面歌词中，当前歌词行按播放进度高亮：逐渐变色使用强调色逐字渲染，也可选择逐渐放大等方式。"/>

            <!-- 歌词颜色：取色对话框 + 颜色代码录入 -->
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="歌词高亮颜色" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="26" Height="26" Fill="{Binding LyricColorText}"
                                 Stroke="{DynamicResource LineBrush}" StrokeThickness="1"/>
                        <Button Style="{StaticResource ChipButtonStyle}" Content="选择颜色…"
                                Margin="12,0,0,0" Padding="14,6" Command="{Binding PickLyricColorCommand}"/>
                        <TextBox Width="110" VerticalAlignment="Center" ToolTip="录入 #RRGGBB 颜色代码"
                                 Text="{Binding LyricColorText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Style="{StaticResource ChipButtonStyle}" Content="跟随强调色"
                                Margin="10,0,0,0" Padding="14,6" Command="{Binding ResetLyricColorCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="留空则跟随强调色；也可直接录入 #RRGGBB 颜色代码即时生效。"/>
                </StackPanel>
            </Border>

            <!-- ================= 音频输出设备 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="音频输出设备" Margin="0,26,0,0"/>
            <ItemsControl ItemsSource="{Binding AudioDevices}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,8" Padding="18,8"
                                MaxWidth="360" Content="{Binding Name}" ToolTip="{Binding Name}"
                                Command="{Binding DataContext.SetAudioDeviceCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.AudioDevice"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,10,0,0"
                       Text="切换输出设备后立即生效，正在播放的曲目会从原进度继续播放。"/>

            <!-- ================= 桌面歌词 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="桌面歌词" Margin="0,26,0,0"/>

            <TextBlock Style="{StaticResource BodyTextStyle}" Text="歌词字体" Margin="0,12,0,0"/>
            <ItemsControl ItemsSource="{Binding DeskLyricFontItems}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0" Padding="18,8"
                                Content="{Binding Name}" FontFamily="{Binding Key}"
                                Command="{Binding DataContext.SetDeskLyricFontCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.DeskLyricFont"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource BodyTextStyle}" Text="歌词颜色" Margin="0,18,0,0"/>
            <ItemsControl ItemsSource="{Binding DeskLyricColorItems}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="44" Height="44" Margin="0,0,10,0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" ToolTip="{Binding Name}"
                                FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.SetDeskLyricColorCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.DeskLyricColor"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Ring" Width="40" Height="40" Fill="Transparent"
                                                 Stroke="{DynamicResource LineBrush}" StrokeThickness="2"/>
                                        <Ellipse Width="30" Height="30" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" Fill="{Binding Extra}"/>
                                        <Path x:Name="Check" Data="{DynamicResource IconCheck}" Width="14"
                                              Height="14" Stretch="Uniform" Fill="White" Opacity="0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource BodyTextStyle}" Text="背景颜色" Margin="0,18,0,0"/>
            <ItemsControl ItemsSource="{Binding DeskLyricColorItems}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="44" Height="44" Margin="0,0,10,0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" ToolTip="{Binding Name}"
                                FocusVisualStyle="{x:Null}"
                                Command="{Binding DataContext.SetDeskLyricBgColorCommand,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualConv}">
                                    <Binding Path="DataContext.DeskLyricBgColor"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </Button.Tag>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Ring" Width="40" Height="40" Fill="Transparent"
                                                 Stroke="{DynamicResource LineBrush}" StrokeThickness="2"/>
                                        <Ellipse Width="30" Height="30" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" Fill="{Binding Extra}"/>
                                        <Path x:Name="Check" Data="{DynamicResource IconCheck}" Width="14"
                                              Height="14" Stretch="Uniform" Fill="White" Opacity="0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 字号与背景透明度微调 -->
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="16,14" Margin="0,18,0,0">
                <Grid MaxWidth="520" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BodyTextStyle}"
                               Text="歌词字号"/>
                    <Slider Grid.Row="0" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                            Minimum="14" Maximum="72" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding DeskLyricFontSize}"
                            Style="{StaticResource QQSliderStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right"
                               FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"
                               Text="{Binding DeskLyricFontSize, StringFormat={}{0}px}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BodyTextStyle}"
                               Text="背景透明度"/>
                    <Slider Grid.Row="2" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                            Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                            Value="{Binding DeskLyricBgOpacity}"
                            Style="{StaticResource QQSliderStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right"
                               FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}"
                               Text="{Binding DeskLyricBgOpacity, StringFormat={}{0}%}"/>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,10,0,0"
                       Text="点击播放条上的「词」按钮开关桌面歌词悬浮窗；拖动歌词窗可移动位置，双击歌词窗返回主窗口。背景透明度默认 0%（全透明）。"/>

            <!-- ================= 滚动方向 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="滚动方向" Margin="0,26,0,0"/>
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14,12"
                    Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox Content="滚动方向与系统一致（手指向下拨动时内容向下滚动）"
                              Style="{StaticResource ThemeCheckBoxStyle}" FontSize="13"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              IsChecked="{Binding ReverseScroll}"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="26,8,0,0" TextWrapping="Wrap"
                               Text="默认开启，滚动方向与系统的“自然滚动”保持一致；若你更习惯传统的滚轮滚动方向，可关闭此开关。"/>
                </StackPanel>
            </Border>

            <!-- ================= 音乐目录 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="音乐目录" Margin="0,26,0,0"/>
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14,12"
                    Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentTextButtonStyle}"
                                Height="32" Padding="14,0" Margin="8,0,0,0"
                                Command="{Binding BrowseMusicDirCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconFolderOpen}" Width="12" Height="12"
                                      Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="浏览…" Margin="6,0,0,0" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentTextButtonStyle}"
                                Height="32" Padding="14,0" Margin="8,0,0,0"
                                Command="{Binding RescanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconRefresh}" Width="12" Height="12"
                                      Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="重新扫描" Margin="6,0,0,0" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBox Height="32" Padding="10,0" FontSize="12" VerticalContentAlignment="Center"
                                 Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                 BorderThickness="1" Foreground="{DynamicResource SecondaryTextBrush}"
                                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                                 Text="{Binding MusicDirectory}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,10,0,0"
                               Text="{Binding SongCountText}"/>
                    <!-- 扫描进度：进度条 + 实时状态文本 -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- ProgressBar.Value 默认 TwoWay 绑定，只读源属性必须显式 OneWay，否则绑定激活即抛异常 -->
                        <ProgressBar Height="4" Maximum="1" BorderThickness="0"
                                     Value="{Binding ScanProgress, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border CornerRadius="2" Background="{DynamicResource LineBrush}"/>
                                        <!-- ProgressBar 依据 PART_Track 宽度计算 PART_Indicator 宽度，二者缺一不可 -->
                                        <Border x:Name="PART_Track">
                                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <TextBlock FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding ScanStatusText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= 关于 ================= -->
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="关于" Margin="0,26,0,0"/>
            <StackPanel Margin="0,10,0,0">
                <TextBlock Style="{StaticResource BodyTextStyle}" Text="MyQQMusic — 本地音乐播放器"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"
                           Text="基于 WPF 打造，完全本地播放，支持明暗主题、强调色与背景切换。"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
