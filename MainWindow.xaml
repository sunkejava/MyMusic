<Window x:Class="MyQQMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:MyQQMusic.ViewModels"
        xmlns:views="clr-namespace:MyQQMusic.Views"
        Title="MyQQMusic" Height="760" Width="1220" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                            CornerRadius="12" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ViewModel → 视图映射 -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistViewModel}"><views:PlaylistView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NowPlayingViewModel}"><views:NowPlayingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>

        <!-- 侧边导航项：圆角悬停/选中高亮，带淡入淡出过渡 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Margin="0,2" CornerRadius="10" Background="Transparent">
                            <Grid>
                                <Border x:Name="Hover" CornerRadius="10" Opacity="0"
                                        Background="{DynamicResource HoverBrush}"/>
                                <Border x:Name="Sel" CornerRadius="10" Opacity="0"
                                        Background="{DynamicResource SelectedRowBrush}"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel"
                                                             Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 红黄绿圆形窗口按钮 -->
        <Style x:Key="TrafficButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Content" Opacity="0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>

            <!-- ================= 顶栏 ================= -->
            <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource TopBarBrush}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="14,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 红黄绿窗口按钮 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TrafficButtonStyle}" Background="#FFFF5F57"
                                ToolTip="关闭" Click="CloseWindow_Click">
                            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#FF7A1F1A"
                                  StrokeThickness="1.3" Width="8" Height="8"/>
                        </Button>
                        <Button Style="{StaticResource TrafficButtonStyle}" Background="#FFFEBC2E"
                                Margin="8,0,0,0" ToolTip="最小化" Click="MinimizeWindow_Click">
                            <Path Data="M 0,4 H 8" Stroke="#FF7A5A12"
                                  StrokeThickness="1.4" Width="8" Height="8"/>
                        </Button>
                        <Button Style="{StaticResource TrafficButtonStyle}" Background="#FF28C840"
                                Margin="8,0,0,0" ToolTip="最大化 / 还原" Click="MaximizeWindow_Click">
                            <Path Data="M 1,7 L 7,7 L 7,1 Z" Fill="#FF116B24" Width="8" Height="8"/>
                        </Button>
                    </StackPanel>

                    <!-- 前进 / 后退 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                ToolTip="返回" Command="{Binding GoBackCommand}"
                                IsEnabled="{Binding CanGoBack}">
                            <Path Data="{DynamicResource IconChevronLeft}" Width="15" Height="15"
                                  Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                Margin="4,0,0,0" ToolTip="前进" Command="{Binding GoForwardCommand}"
                                IsEnabled="{Binding CanGoForward}">
                            <Path Data="{DynamicResource IconChevronRight}" Width="15" Height="15"
                                  Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- 搜索 -->
                    <TextBox Grid.Column="2" Width="300" HorizontalAlignment="Center"
                             Style="{StaticResource SearchBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Border>

            <!-- ================= 侧边导航 + 内容 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="196"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Sidebar" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,10,6,10">
                        <TextBlock DockPanel.Dock="Bottom" Margin="12,0,0,4" FontSize="11"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   Text="{Binding SongCount, StringFormat=共 {0} 首本地音乐}"/>
                        <ListBox Style="{StaticResource PlainListBoxStyle}"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedValuePath="Key"
                                 SelectedValue="{Binding SelectedView, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="40">
                                        <Path x:Name="Ico" HorizontalAlignment="Left" Margin="12,0,0,0"
                                              Width="18" Height="18" Stretch="Uniform"
                                              Data="{Binding Key, Converter={StaticResource NavIcon}}"
                                              Fill="{DynamicResource IconBrush}"/>
                                        <TextBlock x:Name="Txt" Text="{Binding Name}" Margin="46,0,8,0"
                                                   VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                            <Setter TargetName="Ico" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>

                <!-- 播放队列面板：点击播放条“列表”按钮后从右侧滑出（不分页） -->
                <Border x:Name="QueuePanel" Grid.Column="1" Width="330" HorizontalAlignment="Right"
                        Margin="0,8,12,8" Visibility="Collapsed" CornerRadius="12"
                        Background="{DynamicResource QueuePanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="QueueTranslate" X="350"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                    </Border.Effect>
                    <DockPanel Margin="4">
                        <Grid DockPanel.Dock="Top" Margin="12,8,6,6">
                            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"><Run Text="播放列表"/><Run Text=" · " Foreground="{DynamicResource TertiaryTextBrush}"/><Run Text="{Binding PlayQueue.Count, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/><Run Text=" 首"/></TextBlock>
                            <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                    HorizontalAlignment="Right" ToolTip="关闭" Click="QueueClose_Click">
                                <Path Data="{DynamicResource IconClose}" Width="12" Height="12"
                                      Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                            </Button>
                        </Grid>
                        <ListBox x:Name="QueueList" Style="{StaticResource PlainListBoxStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding PlayQueue}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="QueueList_MouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="44" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="2,0">
                                            <TextBlock x:Name="T" Text="{Binding DisplayTitle}" FontSize="13"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Path x:Name="NowIco" Grid.Column="1" Width="12" Height="12"
                                              Stretch="Uniform" Visibility="Collapsed" VerticalAlignment="Center"
                                              Data="{DynamicResource IconVolumeHigh}" Fill="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="Dur" Grid.Column="1" Text="{Binding DurationText}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TertiaryTextBrush}"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource EqualConv}">
                                                    <Binding Path="DataContext.CurrentSong.Id"
                                                             RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                    <Binding Path="Id"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Dur" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="NowIco" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ================= 播放条（播放页打开时背景与播放页一致） ================= -->
            <Border x:Name="PlayerBar" Grid.Row="2" Background="{Binding BarBackground}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- 当前歌曲信息 -->
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 播放条封面：圆形歌曲海报，播放时海报绕自身中心旋转 -->
                        <Grid Grid.Column="0" Width="56" Height="56" Cursor="Hand"
                              RenderTransformOrigin="0.5,0.5"
                              MouseLeftButtonUp="Cover_Click" ToolTip="打开正在播放页">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="BarCoverRot"/>
                            </Grid.RenderTransform>
                            <Border Width="56" Height="56" CornerRadius="28"
                                    Background="{DynamicResource CoverPlaceholderBrush}">
                                <Path Data="{DynamicResource IconMusic}" Width="20" Height="20"
                                      Stretch="Uniform" Fill="{DynamicResource TertiaryTextBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="56" Height="56" CornerRadius="28">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CurrentSong.CoverThumb}"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border Width="56" Height="56" CornerRadius="28"
                                    BorderBrush="#33FFFFFF" BorderThickness="1"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSong.DisplayTitle}" FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentSong.Artist}" FontSize="11"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                Width="34" Height="34" ToolTip="我喜欢"
                                Command="{Binding ToggleFavoriteCommand}">
                            <Path Width="17" Height="17" Stretch="Uniform"
                                  Data="{Binding IsCurrentFavorite, Converter={StaticResource ToggleIcon}, ConverterParameter=IconHeart:IconHeartFilled}"
                                  Fill="{DynamicResource IconBrush}"/>
                        </Button>
                    </Grid>

                    <!-- 播放控制 + 进度 -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                    ToolTip="{Binding ModeName}" Click="ModeButton_Click">
                                <Path Width="17" Height="17" Stretch="Uniform"
                                      Data="{Binding Mode, Converter={StaticResource ModeIcon}}"
                                      Fill="{DynamicResource IconBrush}"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Width="38" Height="38"
                                    Margin="10,0,0,0" ToolTip="上一首" Command="{Binding PreviousCommand}">
                                <Path Data="{DynamicResource IconPrev}" Width="18" Height="18"
                                      Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}"/>
                            </Button>
                            <Button Style="{StaticResource PlayMainButtonStyle}" Margin="12,0"
                                    ToolTip="播放 / 暂停" Command="{Binding TogglePlayCommand}">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="{Binding IsPlaying, Converter={StaticResource ToggleIcon}, ConverterParameter=IconPlay:IconPause}"
                                      Fill="{DynamicResource OnAccentBrush}"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Width="38" Height="38"
                                    ToolTip="下一首" Command="{Binding NextCommand}">
                                <Path Data="{DynamicResource IconNext}" Width="18" Height="18"
                                      Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}"/>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                            <Slider x:Name="ProgressSlider" Grid.Column="1"
                                    Style="{StaticResource QQSliderStyle}"
                                    Minimum="0" Maximum="{Binding Duration}"
                                    Value="{Binding Position, Mode=OneWay}"
                                    MouseLeftButtonUp="ProgressSlider_Click"/>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>
                        </Grid>
                    </Grid>

                    <!-- 音量 / 词 / 列表 / 收藏 / 更多 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                ToolTip="静音 / 取消静音" Click="VolumeMute_Click">
                            <Path Width="17" Height="17" Stretch="Uniform"
                                  Data="{Binding IsMuted, Converter={StaticResource ToggleIcon}, ConverterParameter=IconVolumeHigh:IconVolumeMute}"
                                  Fill="{DynamicResource IconBrush}"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="110" Margin="6,0,0,0"
                                Style="{StaticResource QQSliderStyle}"
                                Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/>
                        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                Margin="14,0,0,0" ToolTip="桌面歌词" Click="DeskLyric_Click">
                            <TextBlock Text="词" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource IconBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                Margin="2,0,0,0" ToolTip="播放列表" Click="QueueButton_Click">
                            <Path Data="{DynamicResource IconPlaylist}" Width="17" Height="17"
                                  Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                Margin="2,0,0,0" ToolTip="收藏到歌单" Click="FavoriteToPlaylist_Click">
                            <Path Data="{DynamicResource IconHeart}" Width="17" Height="17"
                                  Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                Margin="2,0,0,0" ToolTip="更多" Click="MoreButton_Click">
                            <Path Data="{DynamicResource IconMore}" Width="17" Height="17"
                                  Stretch="Uniform" Fill="{DynamicResource IconBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 正在播放页浮层：从底部上滑覆盖顶栏与内容区，播放条保留作为控制条 ================= -->
            <Border x:Name="PlayerOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                    CornerRadius="12,12,0,0" Background="{DynamicResource AppBackgroundBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PlayerOverlayMove"/>
                </Border.RenderTransform>
                <ContentControl Content="{Binding NowPlaying}" Focusable="False"/>
            </Border>
        </Grid>
    </Border>
</Window>
